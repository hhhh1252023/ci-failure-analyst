# Copy to .env and fill in real values. .env is gitignored.

# GitHub Personal Access Token (repo + actions read scope). Optional but
# recommended: raises API rate limit from 60 to 5000 req/h.
GITHUB_TOKEN=

# Monitored repository and workflow
TARGET_OWNER=sgl-project
TARGET_REPO=sglang
WORKFLOW_FILE=pr-test-npu.yml

# LLM (any OpenAI-compatible endpoint)
AI_API_KEY=
AI_API_BASE=https://api.deepseek.com
AI_MODEL=deepseek-chat

# Report repository to publish daily reports
REPORT_REMOTE=https://github.com/hhhh1252023/pass.git
REPORT_BRANCH=REPORT

# Network (optional)
SSL_VERIFY=true
HTTP_PROXY=
HTTPS_PROXY=
